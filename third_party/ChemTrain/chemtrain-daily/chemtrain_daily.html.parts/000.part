  <header class="top">
    <div class="brand">
      <a class="logo-tile" href="https://github.com/ChemTrain" target="_blank" rel="noopener" title="ChemTrain on GitHub" aria-label="ChemTrain on GitHub"><svg class="logo" viewBox="0 0 54.89 76.62" aria-hidden="true"><use href="#ct-logo"/></svg></a>
      <h1>ChemTrain <span>Daily</span></h1>
    </div>
    <nav class="modes" role="tablist" aria-label="Mode">
      <div class="mode-group" role="none"><span class="mode-h" aria-hidden="true">Play</span>
        <div class="tabs" role="none">
          <button id="tab-daily" role="tab" aria-selected="true" aria-controls="view-daily" data-view="daily">Daily quiz</button>
          <button id="tab-beast" role="tab" aria-selected="false" aria-controls="view-beast" data-view="beast">Beast mode</button>
          <button id="tab-set" role="tab" aria-selected="false" aria-controls="view-set" data-view="set">Problem set</button>
        </div>
      </div>
      <div class="mode-group" role="none"><span class="mode-h" aria-hidden="true">More</span>
        <div class="tabs" role="none">
          <button id="tab-apps" role="tab" aria-selected="false" aria-controls="view-apps" data-view="apps">The apps</button>
        </div>
      </div>
    </nav>
  </header>
  <div class="indicator" aria-hidden="true"></div>

  <div class="app">
    <aside class="side">
      <section id="side-daily" aria-labelledby="sd-h">
        <h2 class="side-h" id="sd-h">Your daily quizzes</h2>
        <div class="side-card" id="daily-side"></div>
      </section>
      <section id="side-beast" aria-labelledby="sb-h" hidden>
        <h2 class="side-h" id="sb-h">Best runs</h2>
        <div class="side-card" id="beast-side"></div>
      </section>
      <section id="side-set" aria-labelledby="ss-h" hidden>
        <h2 class="side-h" id="ss-h">Your problem sets</h2>
        <div class="side-card" id="set-side"></div>
      </section>
      <section id="side-apps" aria-labelledby="sa-h" hidden>
        <h2 class="side-h" id="sa-h">Question bank</h2>
        <div class="side-card" id="apps-side"></div>
      </section>
    </aside>
    <main class="main">
      <section id="view-daily" class="stack" role="tabpanel" aria-labelledby="tab-daily"><div id="daily-box"></div></section>
      <section id="view-beast" class="stack" role="tabpanel" aria-labelledby="tab-beast" hidden><div id="beast-box"></div></section>
      <section id="view-set" class="stack" role="tabpanel" aria-labelledby="tab-set" hidden><div id="set-box"></div></section>
      <section id="view-apps" class="stack" role="tabpanel" aria-labelledby="tab-apps" hidden><div id="apps-box"></div></section>
    </main>
  </div>
</div>

