<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<title>ChemTrain Daily</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: the ChemTrain study-app frame (header with grouped tabs, rainbow rule, rail + main column). Daily is
   two questions from each app; Beast mode runs until the first mistake; a problem set is as many questions
   as you ask for, from the topics you pick. Each app keeps one colour, used for its pill and its dot in the
   results; drawings use the apps' shared molecule palette. */
:root {
  --logo-tile: #FFFFFF; --bg: #EDF1F4; --surface: #FFFFFF; --paper: #F6F8FA; --ink: #15212B; --muted: #566472; --line: #D3DBE2;
  --accent: #0D5C78; --accent-ink: #FFFFFF; --accent-soft: #DAEAF1;
  --good: #1B7548; --good-soft: #DCF0E4; --bad: #AD2A20; --bad-soft: #F7E0DC; --warn: #9A6206; --warn-soft: #F6EAD3;
  --m-c: #1B2731; --m-o: #C8261A; --m-n: #2045C4; --m-s: #9A7500; --m-x: #2A7A2F; --m-p: #BF560B; --m-si: #8B5A23; --m-mt: #0B6E8C;
  --hl: #F9CFE1; --hl-ink: #C0175A; --form: #E0217A; --break: #F08A00; --cut: #E07800;
  --a-pka: #2a78d6; --a-rxn: #eb6834; --a-pg: #1baf7a; --a-tmc: #6250d6; --a-rl: #e34948; --a-pr: #0f94a8; --a-rad: #d99a00;
  --f-display: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --f-body: "Public Sans", "Segoe UI", system-ui, sans-serif;
  --f-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --logo-tile: #E6ECF0; --bg: #0D1318; --surface: #151D24; --paper: #10171D; --ink: #E4EBF0; --muted: #94A3B0; --line: #27333D;
    --accent: #5DB7D5; --accent-ink: #08212B; --accent-soft: #173341;
    --good: #5FC88F; --good-soft: #143224; --bad: #F08A7F; --bad-soft: #3A1B18; --warn: #E2AE52; --warn-soft: #362812;
    --m-c: #DCE5EC; --m-o: #FF8A7A; --m-n: #8DB2FF; --m-s: #E6C45A; --m-x: #7DD486; --m-p: #F2A765; --m-si: #DDB07A; --m-mt: #6CC6E2;
    --hl: #5A2140; --hl-ink: #FF8DC1; --form: #FF6FB0; --break: #FFAA3D; --cut: #FFA53D;
    --a-pka: #3987e5; --a-rxn: #d95926; --a-pg: #199e70; --a-tmc: #9085e9; --a-rl: #e66767; --a-pr: #1f9fb3; --a-rad: #c98500;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --logo-tile: #E6ECF0; --bg: #0D1318; --surface: #151D24; --paper: #10171D; --ink: #E4EBF0; --muted: #94A3B0; --line: #27333D;
  --accent: #5DB7D5; --accent-ink: #08212B; --accent-soft: #173341;
  --good: #5FC88F; --good-soft: #143224; --bad: #F08A7F; --bad-soft: #3A1B18; --warn: #E2AE52; --warn-soft: #362812;
  --m-c: #DCE5EC; --m-o: #FF8A7A; --m-n: #8DB2FF; --m-s: #E6C45A; --m-x: #7DD486; --m-p: #F2A765; --m-si: #DDB07A; --m-mt: #6CC6E2;
  --hl: #5A2140; --hl-ink: #FF8DC1; --form: #FF6FB0; --break: #FFAA3D; --cut: #FFA53D;
  --a-pka: #3987e5; --a-rxn: #d95926; --a-pg: #199e70; --a-tmc: #9085e9; --a-rl: #e66767; --a-pr: #1f9fb3; --a-rad: #c98500;
  color-scheme: dark;
}
*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.5 var(--f-body); }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
a { color: var(--accent); }

.wrap {
  max-width: 1160px; margin: 0 auto; display: grid; gap: 18px;
  padding-block: 20px 56px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; min-width: 0; }
h1 { margin: 0; font: 700 30px/1 var(--f-display); letter-spacing: -0.01em; }
h1 span { font-weight: 500; color: var(--muted); }
.brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
.logo-tile { flex: none; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--logo-tile); border: 1px solid var(--line); }
.logo-tile:hover { border-color: var(--accent); }
.logo-tile .logo { width: 27px; height: 38px; }
.foot-brand { white-space: nowrap; }
.foot-brand .logo { width: 20px; height: 22px; padding: 2px 4px; margin-right: 5px; vertical-align: -6px; background: var(--logo-tile); border-radius: 5px; }
.modes { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; min-width: 0; max-width: 100%; }
.mode-group { display: flex; align-items: center; gap: 8px; min-width: 0; max-width: 100%; }
.mode-h { font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.tabs { display: flex; gap: 4px; padding: 4px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; max-width: 100%; overflow-x: auto; scrollbar-width: none; }
.tabs::-webkit-scrollbar { display: none; }
.tabs button { flex: none; white-space: nowrap; border: 0; background: transparent; padding: 7px 14px; border-radius: 8px; font-weight: 600; font-size: 14px; color: var(--muted); cursor: pointer; }
.tabs button:hover { color: var(--ink); }
.tabs button[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); }
.indicator { height: 6px; border-radius: 3px; background: linear-gradient(90deg, hsl(0 72% 52%), hsl(56 80% 50%), hsl(112 55% 44%), hsl(168 60% 40%), hsl(224 62% 54%), hsl(280 52% 54%)); }

.app { display: grid; gap: 22px; align-items: start; }
@media (min-width: 940px) { .app { grid-template-columns: 300px minmax(0, 1fr); } }
.side { display: grid; gap: 22px; min-width: 0; }
.side > * { min-width: 0; }
.main { display: grid; gap: 16px; min-width: 0; }
.side-h { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.side-card { display: grid; gap: 12px; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; font-size: 14px; }
.side-card p { margin: 0; color: var(--muted); }
.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.stat { display: grid; gap: 2px; }
.stat b { font: 700 24px/1.1 var(--f-display); font-variant-numeric: tabular-nums; color: var(--ink); }
.stat span { font-size: 12.5px; color: var(--muted); }
.week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.week div { display: grid; gap: 3px; justify-items: center; font-size: 11px; color: var(--muted); }
.week i { width: 100%; height: 34px; border-radius: 6px; background: var(--paper); border: 1px solid var(--line); display: grid; place-items: center; font: 600 12px var(--f-mono); font-style: normal; color: var(--ink); }
.week i.played { background: var(--good-soft); border-color: var(--good); }
.week i.today { outline: 2px solid var(--accent); outline-offset: 1px; }
.bests { display: grid; gap: 6px; }
.bests div { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
.bests b { font: 600 15px var(--f-mono); font-variant-numeric: tabular-nums; }
.bests button { display: flex; justify-content: space-between; gap: 10px; align-items: center; width: 100%; margin: 0 -8px; padding: 5px 8px; box-sizing: content-box; border: 0; border-radius: 8px; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
.bests button:hover { background: var(--paper); }
.bests button[aria-pressed="true"] { background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px var(--accent); }

.eyebrow { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.help { margin: 0; font-size: 14px; color: var(--muted); max-width: 65ch; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: clamp(18px, 3.5vw, 28px); display: grid; gap: 18px; min-width: 0; }
.qhead { display: grid; gap: 8px; min-width: 0; }
.qtop { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
.tags { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.term { margin: 0; font: 700 clamp(26px, 4.6vw, 36px)/1.12 var(--f-display); letter-spacing: -0.01em; text-wrap: balance; overflow-wrap: anywhere; }
.term.big { font-size: clamp(34px, 7vw, 56px); }
.formula { margin: 0; font: 400 16px/1.4 var(--f-mono); color: var(--muted); overflow-wrap: anywhere; }
.partner { margin: 0; font-size: 15.5px; font-weight: 600; overflow-wrap: anywhere; }
.ask { margin: 0; font-size: 15.5px; color: var(--muted); }
.pill { font-size: 12px; font-weight: 600; padding: 3px 9px; border-radius: 999px; white-space: nowrap; background: var(--paper); border: 1px solid var(--line); color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
.pill.hard { background: var(--warn-soft); border-color: transparent; color: var(--warn); }
.pill.good { background: var(--good-soft); border-color: transparent; color: var(--good); }
.adot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; flex: none; background: var(--a); }
.a-pka { --a: var(--a-pka); } .a-rxn { --a: var(--a-rxn); } .a-pg { --a: var(--a-pg); } .a-tmc { --a: var(--a-tmc); } .a-rl { --a: var(--a-rl); } .a-pr { --a: var(--a-pr); } .a-rad { --a: var(--a-rad); }
.a-all { --a: conic-gradient(var(--a-pka) 0 14.3%, var(--a-rxn) 0 28.6%, var(--a-pg) 0 42.9%, var(--a-tmc) 0 57.1%, var(--a-rl) 0 71.4%, var(--a-pr) 0 85.7%, var(--a-rad) 0); }
.a-all .adot, .adot.a-all { background: var(--a); }

/* figures */
.struct { margin: 0; display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; padding: 18px 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; min-height: 120px; min-width: 0; overflow-x: auto; }
.plus { font: 700 22px var(--f-display); color: var(--muted); }
.arrow { display: grid; justify-items: center; gap: 3px; min-width: 96px; max-width: 220px; text-align: center; font-size: 13.5px; color: var(--muted); }
.arrow i { display: block; width: 100%; height: 2px; background: var(--muted); position: relative; }
.arrow i::after { content: ""; position: absolute; right: -1px; top: -4px; border: 5px solid transparent; border-left: 8px solid var(--muted); border-right: 0; }
.key { padding: 0 4px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); font-weight: 700; white-space: nowrap; }
.blank { display: inline-block; min-width: 1.6em; padding: 0 6px; border-radius: 6px; background: var(--form); color: var(--surface); font-weight: 700; }
.qbox { display: grid; place-items: center; width: 92px; height: 92px; border: 2px dashed var(--line); border-radius: 12px; font: 700 34px var(--f-display); color: var(--muted); }
.pair { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: stretch; }
@media (max-width: 640px) { .pair { grid-template-columns: minmax(0, 1fr); } .pair .plus { justify-self: center; } }
.pcard { margin: 0; display: grid; grid-template-rows: auto 1fr; gap: 8px; padding: 14px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; min-width: 0; }
.pcard .pname { font: 700 17px/1.25 var(--f-display); overflow-wrap: anywhere; }
.pcard .psub { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
.pcard .pmol { display: flex; align-items: center; justify-content: center; min-height: 100px; }

/* molecules: one palette for the drawings of every app */
.mol { display: block; max-width: 100%; height: auto; overflow: visible; flex: none; }
.mol .b { fill: none; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
.mol .h { fill: none; stroke-width: .8; stroke-linecap: round; }
.mol .b.c, .mol .h.c { stroke: var(--m-c); } .mol .b.o, .mol .h.o { stroke: var(--m-o); } .mol .b.n, .mol .h.n { stroke: var(--m-n); }
.mol .b.s, .mol .h.s { stroke: var(--m-s); } .mol .b.x, .mol .h.x { stroke: var(--m-x); } .mol .b.p, .mol .h.p { stroke: var(--m-p); }
.mol .b.si, .mol .h.si { stroke: var(--m-si); } .mol .b.mt, .mol .h.mt { stroke: var(--m-mt); }
.mol .t.c, .mol .w.c { fill: var(--m-c); } .mol .t.o, .mol .w.o { fill: var(--m-o); } .mol .t.n, .mol .w.n { fill: var(--m-n); }
.mol .t.s, .mol .w.s { fill: var(--m-s); } .mol .t.x, .mol .w.x { fill: var(--m-x); } .mol .t.p, .mol .w.p { fill: var(--m-p); }
.mol .t.si, .mol .w.si { fill: var(--m-si); } .mol .t.mt, .mol .w.mt { fill: var(--m-mt); }
.mol .t.nt { fill: var(--accent); }
.mol .b.hh { stroke: var(--hl-ink); stroke-width: 1.8; }
.mol .t.hh { fill: var(--hl-ink); }
.mol .halo { fill: var(--hl); }
.mol .pghalo { fill: var(--accent); fill-opacity: .16; }
.mol .ring { fill: none; stroke: var(--hl-ink); stroke-width: 1.2; opacity: 0; transform-box: fill-box; transform-origin: center; }
@media (prefers-reduced-motion: no-preference) { .struct .mol .ring { animation: ping 1.4s ease-out .25s 2; } }
@keyframes ping { from { opacity: .9; transform: scale(.8); } to { opacity: 0; transform: scale(2); } }
/* Reaction Learn: bonds that form (pink) and break (orange); hidden while the product is the question */
.mol .g { fill: none; stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; opacity: .38; }
.mol .g.f { stroke: var(--form); } .mol .g.r { stroke: var(--break); }
.mol .ga { opacity: .38; } .mol .ga.f { fill: var(--form); } .mol .ga.r { fill: var(--break); }
.veiled .g, .veiled .ga { display: none; }
/* PG Learn: the group that comes off glows orange once answered */
.mol .pgglow line { stroke: transparent; stroke-width: 9; stroke-linecap: round; }
.mol .pgglow rect, .mol .pgglow circle { fill: transparent; }
.mol .pgglow g.rm line { stroke: var(--cut); stroke-opacity: .45; }
.mol .pgglow g.rm rect, .mol .pgglow g.rm circle { fill: var(--cut); fill-opacity: .35; }
.mol .pgs { display: none; }
/* lettered atoms */
.smol .badge { fill: var(--surface); stroke: var(--hl-ink); stroke-width: 1.4; }
.smol .bl { font: 700 9.5px var(--f-mono); fill: var(--hl-ink); pointer-events: none; }
.smol .pick { cursor: pointer; }
.smol .pick:hover .badge { fill: var(--hl); }
.smol .halo.best { fill: var(--good-soft); } .smol .halo.wrong { fill: var(--bad-soft); }
.smol .best .badge { fill: var(--good); stroke: var(--good); } .smol .wrong .badge { fill: var(--bad); stroke: var(--bad); }
.smol .best .bl, .smol .wrong .bl { fill: var(--surface); }
.smol .other .badge { stroke: var(--muted); } .smol .other .bl { fill: var(--muted); }

/* answers */
.options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
@media (max-width: 520px) { .options { grid-template-columns: 1fr; } }
.opt { display: flex; align-items: center; gap: 12px; min-width: 0; text-align: left; padding: 14px 16px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--surface); cursor: pointer; transition: border-color .15s, background .15s; }
.opt:hover:not([disabled]) { border-color: var(--accent); }
.opt[disabled] { cursor: default; }
.opt .key { flex: none; min-width: 24px; height: 24px; padding: 0 5px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 6px; font: 600 12px var(--f-mono); color: var(--muted); }
.opt .val { min-width: 0; display: grid; gap: 4px; overflow-wrap: anywhere; font-weight: 500; }
.opt .val.num { font: 600 20px var(--f-mono); font-variant-numeric: tabular-nums; }
.opt .val small { font-weight: 400; color: var(--muted); font-size: 13px; }
.opt .othumb { display: flex; justify-content: center; }
.opt.mol-opt { align-items: center; }
.opt.mol-opt .val { flex: 1; justify-items: center; text-align: center; }
.opt.correct { border-color: var(--good); background: var(--good-soft); }
.opt.wrong { border-color: var(--bad); background: var(--bad-soft); }
.opt.dim { opacity: .55; }
.btn { border: 0; border-radius: 10px; padding: 12px 18px; font-weight: 600; font-size: 15px; background: var(--accent); color: var(--accent-ink); cursor: pointer; }
.btn.ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
.btn.ghost:hover { border-color: var(--accent); }
.btn.small { padding: 8px 12px; font-size: 13.5px; }
.row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.row.end { justify-content: flex-end; }
.row.between { justify-content: space-between; }
.feedback { border-top: 1px solid var(--line); padding-top: 18px; display: grid; gap: 12px; }
.verdict { margin: 0; font: 700 21px var(--f-display); }
.verdict.good { color: var(--good); } .verdict.bad { color: var(--bad); }
.fbline { margin: 0; color: var(--muted); }
.fbline strong { color: var(--ink); font-weight: 600; }
.note { margin: 0; font-size: 14px; color: var(--muted); padding-left: 12px; border-left: 2px solid var(--line); }
.src { margin: 0; font-size: 13px; color: var(--muted); }
.mech { display: grid; gap: 6px; }
.mech-h { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.mech ol { margin: 0; padding-left: 22px; display: grid; gap: 4px; font-size: 14.5px; max-width: 75ch; }

/* daily progress dots and results */
.dots { display: flex; flex-wrap: wrap; gap: 6px; }
.dots i { width: 26px; height: 8px; border-radius: 4px; background: var(--line); }
.dots i.ok { background: var(--good); } .dots i.no { background: var(--bad); } .dots i.now { background: var(--accent); }
.score { margin: 4px 0 0; font: 700 clamp(52px, 10vw, 80px)/1 var(--f-display); font-variant-numeric: tabular-nums; }
.score small { font-size: .4em; color: var(--muted); font-weight: 500; }
.results { list-style: none; margin: 0; padding: 0; display: grid; }
.results li { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--line); }
.results li:last-child { border-bottom: 0; }
.results .t { min-width: 0; overflow-wrap: anywhere; }
.results .t small { display: block; color: var(--muted); font-size: 13px; }
.share.long { max-height: 8.6em; overflow-y: auto; }
.share { margin: 0; padding: 12px 14px; border-radius: 10px; background: var(--paper); border: 1px solid var(--line); font: 400 14px/1.6 var(--f-mono); white-space: pre-wrap; overflow-wrap: anywhere; user-select: all; }
.msg { font-size: 14px; font-weight: 600; color: var(--good); }

/* beast mode */
.pools { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
.pool { display: grid; gap: 6px; text-align: left; padding: 14px; border: 1.5px solid var(--line); border-radius: 12px; background: var(--surface); cursor: pointer; }
.pool:hover { border-color: var(--accent); }
.pool[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 1.5px var(--accent); }
.pool .nm { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.pool .meta { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
.streak { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.streak b { font: 700 44px/1 var(--f-display); font-variant-numeric: tabular-nums; }
.streak span { color: var(--muted); font-size: 14px; }
.over { display: grid; gap: 8px; padding: 16px; border-radius: 12px; background: var(--bad-soft); }
.over.best { background: var(--good-soft); }
.over h3 { margin: 0; font: 700 22px var(--f-display); }

/* problem set */
.topics { display: grid; gap: 16px; }
.tgroup { display: grid; gap: 8px; }
.tgroup-h { display: flex; align-items: center; gap: 12px; }
.tgroup-h .nm { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border: 1.5px solid var(--line); border-radius: 999px; background: var(--surface); cursor: pointer; font-size: 14px; font-weight: 500; }
.chip:hover { border-color: var(--accent); }
.chip[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
.chip[aria-pressed="true"]::before { content: "✓"; color: var(--accent); font-weight: 700; }
.chip small { color: var(--muted); font: 500 12px var(--f-mono); font-variant-numeric: tabular-nums; }
.chip.only { border-style: dashed; }
.linkbtn { border: 0; background: none; padding: 2px 0; color: var(--accent); font-size: 13.5px; font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.field { display: grid; gap: 8px; }
.field-h { margin: 0; font-weight: 600; }
.count { width: 104px; padding: 7px 10px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--surface); font: 600 16px var(--f-mono); }
.count:focus { border-color: var(--accent); outline: none; }
.progress { height: 8px; border-radius: 4px; background: var(--paper); border: 1px solid var(--line); overflow: hidden; }
.progress i { display: block; height: 100%; background: var(--accent); }
.setline { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
.results b { font: 600 15px var(--f-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }

/* apps */
.apps { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
.appcard { display: grid; gap: 8px; align-content: start; padding: 16px; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--a); border-radius: 12px; }
.appcard h3 { margin: 0; font: 700 19px var(--f-display); }
.appcard p { margin: 0; font-size: 14px; color: var(--muted); }
.appcard .links { display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; font-weight: 600; }
.stack { display: grid; gap: 14px; min-width: 0; }
.foot { max-width: 1160px; margin: -36px auto 0; padding: 0 16px 32px; font-size: 13px; color: var(--muted); text-align: center; text-wrap: balance; }
</style>

