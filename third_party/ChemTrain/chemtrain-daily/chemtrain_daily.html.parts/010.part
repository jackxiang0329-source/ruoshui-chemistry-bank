trode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"−0.26 V"},{"x":"+0.34 V","w":"Cu²⁺/Cu"},{"x":"+2.01 V","w":"S₂O₈²⁻/SO₄²⁻"},{"x":"+2.87 V","w":"F₂/F⁻"}],"t":"Ni²⁺/Ni","f":"nickel as a reductant","fig":{"m":2878},"ex":"E° = −0.26 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"−0.13 V"},{"x":"+0.77 V","w":"Fe³⁺/Fe²⁺"},{"x":"+1.61 V","w":"Ce⁴⁺/Ce³⁺"},{"x":"+0.34 V","w":"Cu²⁺/Cu"}],"t":"Pb²⁺/Pb","f":"lead as a reductant","fig":{"m":2879},"ex":"E° = −0.13 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+0.00 V"},{"x":"−3.04 V","w":"Li⁺/Li"},{"x":"−0.44 V","w":"Fe²⁺/Fe"},{"x":"+2.01 V","w":"S₂O₈²⁻/SO₄²⁻"}],"t":"2H⁺/H₂","f":"the hydrogen electrode","fig":{"m":2880},"ex":"E° = +0.00 V vs SHE in water. Zero by definition: the reference for every E° in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+0.16 V"},{"x":"+1.78 V","w":"H₂O₂/H₂O"},{"x":"+2.87 V","w":"F₂/F⁻"},{"x":"−2.93 V","w":"K⁺/K"}],"t":"Cu²⁺/Cu⁺","f":"copper(II) as a one-electron oxidant","fig":{"m":2881},"ex":"E° = +0.16 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+0.34 V"},{"x":"−2.93 V","w":"K⁺/K"},{"x":"+0.80 V","w":"Ag⁺/Ag"},{"x":"+1.51 V","w":"MnO₄⁻/Mn²⁺"}],"t":"Cu²⁺/Cu","f":"copper(II) to the metal","fig":{"m":2881},"ex":"E° = +0.34 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+0.54 V"},{"x":"+0.00 V","w":"2H⁺/H₂"},{"x":"+2.87 V","w":"F₂/F⁻"},{"x":"+1.61 V","w":"Ce⁴⁺/Ce³⁺"}],"t":"I₂/I⁻","f":"iodine as an oxidant","fig":{"m":2882},"ex":"E° = +0.54 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+0.77 V"},{"x":"+0.00 V","w":"2H⁺/H₂"},{"x":"+2.01 V","w":"S₂O₈²⁻/SO₄²⁻"},{"x":"−0.41 V","w":"Cr³⁺/Cr²⁺"}],"t":"Fe³⁺/Fe²⁺","f":"iron(III) as an oxidant","fig":{"m":2883},"ex":"E° = +0.77 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+0.80 V"},{"x":"−0.76 V","w":"Zn²⁺/Zn"},{"x":"−0.13 V","w":"Pb²⁺/Pb"},{"x":"−2.93 V","w":"K⁺/K"}],"t":"Ag⁺/Ag","f":"silver(I) as an oxidant","fig":{"m":2884},"ex":"E° = +0.80 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.07 V"},{"x":"−0.44 V","w":"Fe²⁺/Fe"},{"x":"+0.34 V","w":"Cu²⁺/Cu"},{"x":"+2.01 V","w":"S₂O₈²⁻/SO₄²⁻"}],"t":"Br₂/Br⁻","f":"bromine as an oxidant","fig":{"m":2885},"ex":"E° = +1.07 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.23 V"},{"x":"−1.66 V","w":"Al³⁺/Al"},{"x":"+0.00 V","w":"2H⁺/H₂"},{"x":"−0.76 V","w":"Zn²⁺/Zn"}],"t":"O₂/H₂O","f":"oxygen, in acid","fig":{"m":2886},"ex":"E° = +1.23 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.33 V"},{"x":"+0.80 V","w":"Ag⁺/Ag"},{"x":"−2.71 V","w":"Na⁺/Na"},{"x":"−0.41 V","w":"Cr³⁺/Cr²⁺"}],"t":"Cr₂O₇²⁻/Cr³⁺","f":"dichromate, in acid","fig":{"m":2887},"ex":"E° = +1.33 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.36 V"},{"x":"−2.71 V","w":"Na⁺/Na"},{"x":"+1.92 V","w":"Co³⁺/Co²⁺"},{"x":"−0.76 V","w":"Zn²⁺/Zn"}],"t":"Cl₂/Cl⁻","f":"chlorine as an oxidant","fig":{"m":2888},"ex":"E° = +1.36 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.51 V"},{"x":"+1.07 V","w":"Br₂/Br⁻"},{"x":"−3.04 V","w":"Li⁺/Li"},{"x":"−0.44 V","w":"Fe²⁺/Fe"}],"t":"MnO₄⁻/Mn²⁺","f":"permanganate, in acid","fig":{"m":2889},"ex":"E° = +1.51 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.61 V"},{"x":"−0.13 V","w":"Pb²⁺/Pb"},{"x":"+0.54 V","w":"I₂/I⁻"},{"x":"−2.93 V","w":"K⁺/K"}],"t":"Ce⁴⁺/Ce³⁺","f":"cerium(IV) as an oxidant (CAN)","fig":{"m":2890},"ex":"E° = +1.61 V vs SHE in water. Cerium(IV) is stronger than chlorine. Its potential depends on the acid used.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.78 V"},{"x":"+1.36 V","w":"Cl₂/Cl⁻"},{"x":"+0.00 V","w":"2H⁺/H₂"},{"x":"+0.80 V","w":"Ag⁺/Ag"}],"t":"H₂O₂/H₂O","f":"hydrogen peroxide, in acid","fig":{"m":2891},"ex":"E° = +1.78 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+1.92 V"},{"x":"−0.76 V","w":"Zn²⁺/Zn"},{"x":"+1.36 V","w":"Cl₂/Cl⁻"},{"x":"−0.13 V","w":"Pb²⁺/Pb"}],"t":"Co³⁺/Co²⁺","f":"cobalt(III) as an oxidant","fig":{"m":2892},"ex":"E° = +1.92 V vs SHE in water.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+2.01 V"},{"x":"+2.87 V","w":"F₂/F⁻"},{"x":"−0.76 V","w":"Zn²⁺/Zn"},{"x":"−0.13 V","w":"Pb²⁺/Pb"}],"t":"S₂O₈²⁻/SO₄²⁻","f":"persulfate as an oxidant","fig":{"m":2893},"ex":"E° = +2.01 V vs SHE in water. In photoredox, persulfate is an oxidative quencher that gives the sulfate radical anion.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Potential","a":"What is its E° vs SHE in water?","o":[{"x":"+2.87 V"},{"x":"−2.93 V","w":"K⁺/K"},{"x":"−0.41 V","w":"Cr³⁺/Cr²⁺"},{"x":"−1.66 V","w":"Al³⁺/Al"}],"t":"F₂/F⁻","f":"fluorine as an oxidant","fig":{"m":2894},"ex":"E° = +2.87 V vs SHE in water. The strongest oxidant in the table.","lk":[{"h":"Source","l":[["Standard electrode potential (data page), Wikipedia","https://en.wikipedia.org/wiki/Standard_electrode_potential_(data_page)"]]}]},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Trifluoromethylation of arenes","p":"Conditions: Ru(phen)₃Cl₂, CF₃SO₂Cl, K₂HPO₄, MeCN, light","fig":{"m":2895},"ex":"*Ru(phen)₃²⁺ (−0.90 V) gives an electron to triflyl chloride (−0.18 V), which loses Cl⁻ and SO₂ to give CF₃•. Only CF₃SO₂Cl quenched the emission (Stern–Volmer); the arenes did not. Ru(phen)₃³⁺ (+1.31 V) then oxidises the cyclohexadienyl radical (−0.1 V) after CF₃• adds, closing the cycle.","lk":[{"h":"Source","l":[["Nagib & MacMillan, Nature 2011","https://pmc.ncbi.nlm.nih.gov/articles/PMC3310175/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"α-Amino C–H arylation","p":"Conditions: Ir(ppy)₃, 1,4-dicyanobenzene, NaOAc, DMA, light","fig":{"m":2896},"ex":"*Ir(ppy)₃ (−1.73 V) reduces 1,4-dicyanobenzene (−1.61 V); luminescence quenching supports this. Ir(IV) (+0.77 V) then oxidises the N-aryl amine to its radical cation, whose α-amino radical couples with the arene radical anion.","lk":[{"h":"Source","l":[["McNally, Prier & MacMillan, Science 2011","https://pmc.ncbi.nlm.nih.gov/articles/PMC3266580/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Decarboxylative arylation (photoredox and nickel)","p":"Conditions: Ir[dF(CF₃)ppy]₂(dtbbpy)PF₆, NiCl₂·glyme, dtbbpy, Cs₂CO₃, aryl iodide, light","fig":{"m":2839},"ex":"*Ir(III) (+1.21 V) takes an electron from the carboxylate (Boc-Pro-OCs, +0.95 V); CO₂ is lost and the α-amino radical joins nickel. Ir(II) (−1.37 V) then reduces Ni(I) to Ni(0) (Ni(II)/Ni(0): −1.2 V in DMF), closing both cycles.","lk":[{"h":"Source","l":[["Zuo et al., Science 2014 (decarboxylative arylation)","https://pmc.ncbi.nlm.nih.gov/articles/PMC4296524/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Benzylic trifluoroborate cross-coupling (photoredox and nickel)","p":"Conditions: Ir[dF(CF₃)ppy]₂(bpy)PF₆, Ni(COD)₂, dtbbpy, 2,6-lutidine, aryl bromide, light","fig":{"m":2840},"ex":"The excited iridium catalyst (+1.32 V) oxidises the benzyl trifluoroborate (+1.10 V; both values from Primer et al. 2015); the C–B bond breaks and nickel captures the benzyl radical: single-electron transmetalation. The reduced iridium then reduces Ni(I) back to Ni(0).","lk":[{"h":"Source","l":[["Tellis, Primer & Molander, Science 2014","https://pmc.ncbi.nlm.nih.gov/articles/PMC4406487/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Anti-Markovnikov hydroetherification of alkenols","p":"Conditions: Mes-Acr-Me⁺ ClO₄⁻, 2-phenylmalononitrile, DCE, 450 nm","fig":{"m":2897},"ex":"*Mes-Acr⁺ (+2.06 V) takes an electron from the alkene, giving its radical cation; the alcohol adds at the less substituted carbon. The acridine radical (−0.57 V) gives the electron back to the radical left after hydrogen-atom transfer from the malononitrile.","lk":[{"h":"Source","l":[["Hamilton & Nicewicz, J. Am. Chem. Soc. 2012","https://pmc.ncbi.nlm.nih.gov/articles/PMC3513336/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Radical cation Diels–Alder","p":"Conditions: Ru(bpz)₃(BArF)₂, isoprene, CH₂Cl₂, light","fig":{"m":2898},"ex":"*Ru(bpz)₃²⁺ (+1.4 V) is oxidising enough to take an electron from anethole (+1.1 V) directly. With Ru(bpy)₃²⁺ (+0.77 V) and no co-oxidant, the reaction fails: under air its excited state is quenched by energy transfer, so the Ru(III) oxidant never forms.","lk":[{"h":"Source","l":[["Lin, Ischay, Fry & Yoon, J. Am. Chem. Soc. 2011","https://pmc.ncbi.nlm.nih.gov/articles/PMC3227774/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"[2+2] cycloaddition of bis(styrenes)","p":"Conditions: Ru(bpy)₃Cl₂, methyl viologen (MV²⁺), light","fig":{"m":2899},"ex":"Methyl viologen takes an electron from *Ru(bpy)₃²⁺. The resulting Ru(bpy)₃³⁺ (+1.29 V) is strong enough to oxidise the electron-rich styrene (+1.2 V for anethole); the excited state itself (+0.77 V) is not.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"[2+2] cycloaddition of bis(enones)","p":"Conditions: Ru(bpy)₃Cl₂, iPr₂NEt, LiBF₄, light","fig":{"m":2900},"ex":"Hünig's base is required: it reduces *Ru(bpy)₃²⁺ to Ru(bpy)₃⁺ (−1.33 V), which gives an electron to the Li⁺-activated enone. The radical anion cyclises.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Reductive radical cyclisation","p":"Conditions: Ru(bpy)₃Cl₂, a tertiary amine, light","fig":{"m":2901},"ex":"As in Stephenson's tin-free dehalogenations: the tertiary amine quenches *Ru(bpy)₃²⁺, and Ru(bpy)₃⁺ reduces the activated C–Br bond. The radical adds to the tethered alkene.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Enantioselective α-benzylation of aldehydes","p":"Conditions: Ir(ppy)₃, imidazolidinone catalyst, electron-poor benzyl bromide, light","fig":{"m":2902},"ex":"*Ir(ppy)₃ (−1.73 V) reduces the electron-poor benzyl bromide directly. Ir(IV) (+0.77 V) then oxidises the α-amino radical formed when the benzyl radical adds to the enamine.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Enantioselective α-trifluoromethylation of aldehydes","p":"Conditions: Ir(ppy)₂(dtbbpy)PF₆, imidazolidinone catalyst, CF₃I, light","fig":{"m":2903},"ex":"The excited catalyst is quenched first (by the electron-rich α-amino radical), giving Ir(II) (−1.51 V), which is reducing enough to give an electron to CF₃I (−1.22 V).","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"α-Acylation of amines (NHC and photoredox)","p":"Conditions: Ru(bpy)₃Cl₂, m-dinitrobenzene, NHC catalyst, aldehyde, light","fig":{"m":2904},"ex":"m-Dinitrobenzene (−0.90 V) is proposed to take an electron from *Ru(bpy)₃²⁺ (−0.81 V), slightly uphill on paper. Ru(bpy)₃³⁺ (+1.29 V) then oxidises the tetrahydroisoquinoline to the iminium ion that the NHC-bound acyl anion attacks.","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"α-Alkylation of aldehydes with eosin Y","p":"Conditions: Eosin Y, imidazolidinone catalyst, diethyl bromomalonate, light","fig":{"m":2905},"ex":"Triplet eosin Y (+0.83 V) oxidises the α-amino radical to the iminium ion; the eosin radical anion (−1.06 V) then reduces bromomalonate (−0.62 V). The same cycle as with Ru(bpy)₃²⁺.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Amide α-functionalisation with persulfate","p":"Conditions: Ru(bpy)₃Cl₂, K₂S₂O₈, DMF, light","fig":{"m":2837},"ex":"Amides are too hard to oxidise (+2.3 V for DMF). Persulfate takes an electron from *Ru(bpy)₃²⁺ instead; the sulfate radical anion abstracts a hydrogen atom from the amide.","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Reduction of electron-poor alkenes by BNAH","p":"Conditions: Ru(bpy)₃Cl₂, BNAH, light","fig":{"m":2906},"ex":"Stern–Volmer: BNAH (+0.76 V) quenches *Ru(bpy)₃²⁺ (+0.77 V), dimethyl maleate does not. Ru(bpy)₃⁺ (−1.33 V) then reduces the alkene.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Reductive quenching (the excited catalyst takes an electron first)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Energy transfer (no electron changes hands)"}],"t":"Malonyl radical alkylation of heteroarenes","p":"Conditions: Ru(bpy)₃Cl₂, 4-MeO-C₆H₄NPh₂, diethyl bromomalonate, light","fig":{"m":2907},"ex":"The triarylamine reduces *Ru(bpy)₃²⁺ to Ru(bpy)₃⁺, which reduces bromomalonate. Its radical cation has no α-hydrogens, so the malonyl radical adds to the indole instead of abstracting a hydrogen atom (which would only dehalogenate).","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Energy transfer (no electron changes hands)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"}],"t":"A norbornadiene to quadricyclane","p":"Conditions: Ru(bpy)₃²⁺, light","fig":{"m":2908},"ex":"Neither electron transfer is downhill: the diene's oxidation (+1.82 V) and reduction (−1.39 V) are out of reach of *Ru(bpy)₃²⁺ (+0.77 V, −0.81 V). Triplet–triplet energy transfer promotes it to its triplet, which closes to quadricyclane.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Quenching cycle","a":"How does the excited photocatalyst start the cycle?","o":[{"x":"Energy transfer (no electron changes hands)"},{"x":"Oxidative quenching (the excited catalyst gives an electron away first)"},{"x":"Reductive quenching (the excited catalyst takes an electron first)"}],"t":"[2+2] cycloaddition of styrenes by energy transfer","p":"Conditions: Ir[dF(CF₃)ppy]₂(dtbbpy)PF₆, light","fig":{"m":2909},"ex":"The excited iridium catalyst (+1.21 V) cannot oxidise the styrene (+1.42 V), but its triplet energy (61 kcal/mol) matches the styrene's (about 60 kcal/mol): energy transfer, then cycloaddition.","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Mes-Acr-Me⁺"},{"x":"Ru(bpy)₃²⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ir(ppy)₂(dtbbpy)⁺"}],"t":"Oxidise phenol, reduce PIFA","p":"Potentials: Phenol +1.63 V (oxidation) · PIFA −0.26 V (reduction), vs SCE","fig":{"m":2910},"ex":"Mes-Acr-Me⁺ works by reductive quenching: phenol to the excited catalyst, −0.43 eV; reduced catalyst to PIFA, −0.31 eV. Ru(bpy)₃²⁺: oxidative quenching fails at phenol to the oxidised catalyst (+0.34 eV); reductive quenching fails at phenol to the excited catalyst (+0.86 eV). fac-Ir(ppy)₃: oxidative quenching fails at phenol to the oxidised catalyst (+0.86 eV); reductive quenching fails at phenol to the excited catalyst (+1.32 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at phenol to the oxidised catalyst (+0.42 eV); reductive quenching fails at phenol to the excited catalyst (+0.97 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","lk":[{"h":"Source","l":[["Hamilton & Nicewicz, J. Am. Chem. Soc. 2012","https://pmc.ncbi.nlm.nih.gov/articles/PMC3513336/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Mes-Acr-Me⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ru(bpm)₃²⁺"},{"x":"Ir(ppy)₂(dtbbpy)⁺"}],"t":"Oxidise furan, reduce trifluoroacetic anhydride","p":"Potentials: Furan +1.94 V (oxidation) · Trifluoroacetic anhydride −0.20 V (reduction), vs SCE","fig":{"m":2911},"ex":"Mes-Acr-Me⁺ works by reductive quenching: furan to the excited catalyst, −0.12 eV; reduced catalyst to trifluoroacetic anhydride, −0.37 eV. fac-Ir(ppy)₃: oxidative quenching fails at furan to the oxidised catalyst (+1.17 eV); reductive quenching fails at furan to the excited catalyst (+1.63 eV). Ru(bpm)₃²⁺: oxidative quenching fails at furan to the oxidised catalyst (+0.25 eV); reductive quenching fails at furan to the excited catalyst (+0.95 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at furan to the oxidised catalyst (+0.73 eV); reductive quenching fails at furan to the excited catalyst (+1.28 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","h":true,"lk":[{"h":"Source","l":[["Hamilton & Nicewicz, J. Am. Chem. Soc. 2012","https://pmc.ncbi.nlm.nih.gov/articles/PMC3513336/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Mes-Acr-Me⁺"},{"x":"Ir(ppy)₂(dtbbpy)⁺"},{"x":"Ru(bpy)₃²⁺"},{"x":"Ru(phen)₃²⁺"}],"t":"Oxidise diphenylacetylene, reduce PIFA","p":"Potentials: Diphenylacetylene +1.84 V (oxidation) · PIFA −0.26 V (reduction), vs SCE","fig":{"m":2912},"ex":"Mes-Acr-Me⁺ works by reductive quenching: diphenylacetylene to the excited catalyst, −0.22 eV; reduced catalyst to PIFA, −0.31 eV. Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at diphenylacetylene to the oxidised catalyst (+0.63 eV); reductive quenching fails at diphenylacetylene to the excited catalyst (+1.18 eV). Ru(bpy)₃²⁺: oxidative quenching fails at diphenylacetylene to the oxidised catalyst (+0.55 eV); reductive quenching fails at diphenylacetylene to the excited catalyst (+1.07 eV). Ru(phen)₃²⁺: oxidative quenching fails at diphenylacetylene to the oxidised catalyst (+0.58 eV); reductive quenching fails at diphenylacetylene to the excited catalyst (+1.02 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","lk":[{"h":"Source","l":[["Hamilton & Nicewicz, J. Am. Chem. Soc. 2012","https://pmc.ncbi.nlm.nih.gov/articles/PMC3513336/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Mes-Acr-Me⁺"},{"x":"Ru(bpy)₃²⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ir(ppy)₂(dtbbpy)⁺"}],"t":"Oxidise naphthalene, reduce PIFA","p":"Potentials: Naphthalene +1.64 V (oxidation) · PIFA −0.26 V (reduction), vs SCE","fig":{"m":2913},"ex":"Mes-Acr-Me⁺ works by reductive quenching: naphthalene to the excited catalyst, −0.42 eV; reduced catalyst to PIFA, −0.31 eV. Ru(bpy)₃²⁺: oxidative quenching fails at naphthalene to the oxidised catalyst (+0.35 eV); reductive quenching fails at naphthalene to the excited catalyst (+0.87 eV). fac-Ir(ppy)₃: oxidative quenching fails at naphthalene to the oxidised catalyst (+0.87 eV); reductive quenching fails at naphthalene to the excited catalyst (+1.33 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at naphthalene to the oxidised catalyst (+0.43 eV); reductive quenching fails at naphthalene to the excited catalyst (+0.98 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","lk":[{"h":"Source","l":[["Hamilton & Nicewicz, J. Am. Chem. Soc. 2012","https://pmc.ncbi.nlm.nih.gov/articles/PMC3513336/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺"},{"x":"Ir(ppy)₂(dtbbpy)⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ru(phen)₃²⁺"}],"t":"Oxidise 4-methoxybenzyl alcohol, reduce bromotrichloromethane","p":"Potentials: 4-Methoxybenzyl alcohol +1.52 V (oxidation) · Bromotrichloromethane −0.18 V (reduction), vs SCE","fig":{"m":2914},"ex":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺ works by oxidative quenching: excited catalyst to bromotrichloromethane, −0.71 eV; 4-methoxybenzyl alcohol to the oxidised catalyst, −0.17 eV. Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.31 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.86 eV). fac-Ir(ppy)₃: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.75 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+1.21 eV). Ru(phen)₃²⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.26 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.70 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013, Table 1","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺"},{"x":"Ru(phen)₃²⁺"},{"x":"Ir(ppy)₂(dtbbpy)⁺"},{"x":"Ru(bpy)₃²⁺"}],"t":"Oxidise thioanisole, reduce benzenediazonium","p":"Potentials: Thioanisole +1.44 V (oxidation) · Benzenediazonium −0.10 V (reduction), vs SCE","fig":{"m":2915},"ex":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺ works by oxidative quenching: excited catalyst to benzenediazonium, −0.79 eV; thioanisole to the oxidised catalyst, −0.25 eV. Ru(phen)₃²⁺: oxidative quenching fails at thioanisole to the oxidised catalyst (+0.18 eV); reductive quenching fails at thioanisole to the excited catalyst (+0.62 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at thioanisole to the oxidised catalyst (+0.23 eV); reductive quenching fails at thioanisole to the excited catalyst (+0.78 eV). Ru(bpy)₃²⁺: oxidative quenching fails at thioanisole to the oxidised catalyst (+0.15 eV); reductive quenching fails at thioanisole to the excited catalyst (+0.67 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013, Table 1","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺"},{"x":"Ru(bpy)₃²⁺"},{"x":"Ru(bpm)₃²⁺"},{"x":"Ir(ppy)₂(dtbbpy)⁺"}],"t":"Oxidise 4-methoxybenzyl alcohol, reduce benzenesulfonyl chloride","p":"Potentials: 4-Methoxybenzyl alcohol +1.52 V (oxidation) · Benzenesulfonyl chloride −0.45 V (reduction), vs SCE","fig":{"m":2916},"ex":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺ works by oxidative quenching: excited catalyst to benzenesulfonyl chloride, −0.44 eV; 4-methoxybenzyl alcohol to the oxidised catalyst, −0.17 eV. Ru(bpy)₃²⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.23 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.75 eV). Ru(bpm)₃²⁺: oxidative quenching fails at excited catalyst to benzenesulfonyl chloride (+0.24 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.53 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.31 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.86 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013, Table 1","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ir(ppy)₂(dtbbpy)⁺"},{"x":"Ru(phen)₃²⁺"}],"t":"Oxidise thioanisole, reduce bromotrichloromethane","p":"Potentials: Thioanisole +1.44 V (oxidation) · Bromotrichloromethane −0.18 V (reduction), vs SCE","fig":{"m":2917},"ex":"Ir[dF(CF₃)ppy]₂(dtbbpy)⁺ works by oxidative quenching: excited catalyst to bromotrichloromethane, −0.71 eV; thioanisole to the oxidised catalyst, −0.25 eV. fac-Ir(ppy)₃: oxidative quenching fails at thioanisole to the oxidised catalyst (+0.67 eV); reductive quenching fails at thioanisole to the excited catalyst (+1.13 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at thioanisole to the oxidised catalyst (+0.23 eV); reductive quenching fails at thioanisole to the excited catalyst (+0.78 eV). Ru(phen)₃²⁺: oxidative quenching fails at thioanisole to the oxidised catalyst (+0.18 eV); reductive quenching fails at thioanisole to the excited catalyst (+0.62 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013, Table 1","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ru(bpz)₃²⁺"},{"x":"Ru(bpy)₃²⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ir(ppy)₂(dtbbpy)⁺"}],"t":"Oxidise phenol, reduce benzenediazonium","p":"Potentials: Phenol +1.63 V (oxidation) · Benzenediazonium −0.10 V (reduction), vs SCE","fig":{"m":2918},"ex":"Ru(bpz)₃²⁺ works by oxidative quenching: excited catalyst to benzenediazonium, −0.16 eV; phenol to the oxidised catalyst, −0.23 eV. Ru(bpy)₃²⁺: oxidative quenching fails at phenol to the oxidised catalyst (+0.34 eV); reductive quenching fails at phenol to the excited catalyst (+0.86 eV). fac-Ir(ppy)₃: oxidative quenching fails at phenol to the oxidised catalyst (+0.86 eV); reductive quenching fails at phenol to the excited catalyst (+1.32 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at phenol to the oxidised catalyst (+0.42 eV); reductive quenching fails at phenol to the excited catalyst (+0.97 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013, Table 1","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ru(bpm)₃²⁺"},{"x":"Ir(ppy)₂(dtbbpy)⁺"},{"x":"Ru(bpy)₃²⁺"},{"x":"Ru(phen)₃²⁺"}],"t":"Oxidise 4-methoxybenzyl alcohol, reduce benzenediazonium","p":"Potentials: 4-Methoxybenzyl alcohol +1.52 V (oxidation) · Benzenediazonium −0.10 V (reduction), vs SCE","fig":{"m":2919},"ex":"Ru(bpm)₃²⁺ works by oxidative quenching: excited catalyst to benzenediazonium, −0.11 eV; 4-methoxybenzyl alcohol to the oxidised catalyst, −0.17 eV. Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.31 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.86 eV). Ru(bpy)₃²⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.23 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.75 eV). Ru(phen)₃²⁺: oxidative quenching fails at 4-methoxybenzyl alcohol to the oxidised catalyst (+0.26 eV); reductive quenching fails at 4-methoxybenzyl alcohol to the excited catalyst (+0.70 eV). ΔG for each step is E(donor) − E(acceptor), in eV.","h":true,"lk":[{"h":"Source","l":[["Prier, Rankic & MacMillan, Chem. Rev. 2013, Table 1","https://pmc.ncbi.nlm.nih.gov/articles/PMC4028850/"]]}],"x":true},{"s":"pr","k":"Pick the photocatalyst","a":"Which photocatalyst can do both electron transfers, by one quenching cycle or the other?","o":[{"x":"Ru(bpz)₃²⁺"},{"x":"fac-Ir(ppy)₃"},{"x":"Ir(ppy)₂(dtbbpy)⁺"},{"x":"Ru(phen)₃²⁺"}],"t":"Oxidise acetate, reduce benzenediazonium","p":"Potentials: Acetate +1.47 V (oxidation) · Benzenediazonium −0.10 V (reduction), vs SCE","fig":{"m":2920},"ex":"Ru(bpz)₃²⁺ works by oxidative quenching: excited catalyst to benzenediazonium, −0.16 eV; acetate to the oxidised catalyst, −0.39 eV. fac-Ir(ppy)₃: oxidative quenching fails at acetate to the oxidised catalyst (+0.70 eV); reductive quenching fails at acetate to the excited catalyst (+1.16 eV). Ir(ppy)₂(dtbbpy)⁺: oxidative quenching fails at acetate to the oxidised catalyst (+0.26 eV); reductive quenching fails at acetate to the excited catalyst (+0.81 eV). Ru(phen)₃²⁺: oxidative quenching fails at acetate to the oxidised catalyst (+0.21 eV); reductive quenching