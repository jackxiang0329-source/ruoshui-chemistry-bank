e","l":[["Mayr database entry 32","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/32"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"1.33"},{"x":"4.91","w":"Ethyl diazoacetate"},{"x":"9","w":"1-Methoxy-2-methyl-1-(trimethylsiloxy)propene"},{"x":"−2.77","w":"1-Hexene"}],"t":"Furan","f":"C₄H₄O","fig":{"m":2463},"ex":"N = 1.33, sN = 1.29 in CH₂Cl₂. Attack at C2 gives a cation shared over three atoms, one of them O.","lk":[{"h":"Source","l":[["Mayr database entry 164","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/164"],["J. Am. Chem. Soc. 2012, 134, 13902-13911","https://doi.org/10.1021/ja306522b"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"3.61"},{"x":"14.91","w":"1-Pyrrolidinocyclohexene"},{"x":"5.85","w":"N-Methylpyrrole"},{"x":"0.78","w":"Styrene"}],"t":"2-Methylfuran","fig":{"m":2464},"ex":"N = 3.61, sN = 1.11 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 42","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/42"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"1.35"},{"x":"5.46","w":"Allyltributylstannane"},{"x":"11.4","w":"1-Morpholinocyclohexene"},{"x":"3.76","w":"n-Butyl vinyl ether"}],"t":"2-Methylthiophene","fig":{"m":2465},"ex":"N = 1.35, sN = 0.99 in CH₂Cl₂. Less nucleophilic than 2-methylfuran: the usual order is pyrrole > furan > thiophene.","lk":[{"h":"Source","l":[["Mayr database entry 30","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/30"],["J. Am. Chem. Soc. 2012, 134, 13902-13911","https://doi.org/10.1021/ja306522b"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.85"},{"x":"8.57","w":"Danishefsky's diene"},{"x":"0.84","w":"2-Methylpent-1-ene"},{"x":"3.76","w":"n-Butyl vinyl ether"}],"t":"N-Methylpyrrole","fig":{"m":2466},"ex":"N = 5.85, sN = 1.03 in CH₂Cl₂. Nitrogen is the best π-donor of the three heteroatoms.","lk":[{"h":"Source","l":[["Mayr database entry 43","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/43"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.55"},{"x":"9.81","w":"1,1-Diethoxyethene"},{"x":"3.61","w":"2-Methylfuran"},{"x":"14.91","w":"1-Pyrrolidinocyclohexene"}],"t":"Indole","f":"C₈H₇N","fig":{"m":2467},"ex":"N = 5.55, sN = 1.09 in CH₂Cl₂. Indoles react at C3: nitrogen stabilises the cation without breaking up the benzene ring.","lk":[{"h":"Source","l":[["Mayr database entry 78","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/78"],["J. Org. Chem. 2006, 71, 9088-9095","https://doi.org/10.1021/jo0614339"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"1.68"},{"x":"8.57","w":"Danishefsky's diene"},{"x":"5.55","w":"Indole"},{"x":"10.48","w":"Diazomethane"}],"t":"Allyltrimethylsilane","f":"CH₂=CHCH₂SiMe₃","fig":{"m":2468},"ex":"N = 1.68, sN = 1.00 in CH₂Cl₂. Attack at the far carbon gives a cation β to silicon, stabilised by the C–Si bond (the β-silicon effect).","lk":[{"h":"Source","l":[["Mayr database entry 33","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/33"],["J. Am. Chem. Soc. 2012, 134, 13902-13911","https://doi.org/10.1021/ja306522b"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.46"},{"x":"0.78","w":"Styrene"},{"x":"8.57","w":"Danishefsky's diene"},{"x":"3.61","w":"2-Methylfuran"}],"t":"Allyltributylstannane","f":"CH₂=CHCH₂SnBu₃","fig":{"m":2469},"ex":"N = 5.46, sN = 0.89 in CH₂Cl₂. A C–Sn bond is a better donor than C–Si: about 4 N units more than the allylsilane.","lk":[{"h":"Source","l":[["Mayr database entry 36","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/36"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"3.76"},{"x":"0.08","w":"1-Methylcyclohexene"},{"x":"−4.36","w":"Toluene"},{"x":"9","w":"1-Methoxy-2-methyl-1-(trimethylsiloxy)propene"}],"t":"n-Butyl vinyl ether","f":"CH₂=CHOC₄H₉","fig":{"m":2470},"ex":"N = 3.76, sN = 0.91 in CH₂Cl₂. The oxygen lone pair pushes electron density onto the terminal carbon.","lk":[{"h":"Source","l":[["Mayr database entry 958","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/958"],["J. Am. Chem. Soc. 2012, 134, 13902-13911","https://doi.org/10.1021/ja306522b"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.21"},{"x":"3.61","w":"2-Methylfuran"},{"x":"1.33","w":"Furan"},{"x":"8.57","w":"Danishefsky's diene"}],"t":"1-(Trimethylsiloxy)cyclohexene","fig":{"m":2471},"ex":"N = 5.21, sN = 1.00 in CH₂Cl₂. A silyl enol ether: the enolate equivalent of the Mukaiyama aldol reaction.","lk":[{"h":"Source","l":[["Mayr database entry 44","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/44"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.41"},{"x":"1.35","w":"2-Methylthiophene"},{"x":"3.61","w":"2-Methylfuran"},{"x":"−2.77","w":"1-Hexene"}],"t":"2-(Trimethylsiloxy)propene","f":"CH₂=C(CH₃)OSiMe₃","fig":{"m":2472},"ex":"N = 5.41, sN = 0.91 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 45","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/45"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"8.57"},{"x":"0.78","w":"Styrene"},{"x":"−2.77","w":"1-Hexene"},{"x":"5.47","w":"tert-Butyl isocyanide"}],"t":"Danishefsky's diene","fig":{"m":2473},"ex":"N = 8.57, sN = 0.84 in CH₂Cl₂. Two oxygen donors on one diene.","lk":[{"h":"Source","l":[["Mayr database entry 38","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/38"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"9"},{"x":"1.68","w":"Allyltrimethylsilane"},{"x":"5.55","w":"Indole"},{"x":"3.61","w":"2-Methylfuran"}],"t":"1-Methoxy-2-methyl-1-(trimethylsiloxy)propene","f":"Me₂C=C(OMe)OSiMe₃","fig":{"m":2474},"ex":"N = 9, sN = 0.98 in CH₂Cl₂. A silyl ketene acetal: two oxygens on the same carbon make it far more nucleophilic than a silyl enol ether.","lk":[{"h":"Source","l":[["Mayr database entry 226","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/226"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"9.81"},{"x":"1.11","w":"Isobutylene"},{"x":"4.91","w":"Ethyl diazoacetate"},{"x":"−2.77","w":"1-Hexene"}],"t":"1,1-Diethoxyethene","f":"CH₂=C(OC₂H₅)₂","fig":{"m":2475},"ex":"N = 9.81, sN = 0.81 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 336","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/336"],["Eur. J. Org. Chem. 2004, , 2791-2796","https://doi.org/10.1002/ejoc.200400134"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"11.4"},{"x":"0.08","w":"1-Methylcyclohexene"},{"x":"3.61","w":"2-Methylfuran"},{"x":"1.68","w":"Allyltrimethylsilane"}],"t":"1-Morpholinocyclohexene","fig":{"m":2476},"ex":"N = 11.4, sN = 0.83 in CH₂Cl₂. Enamines are far stronger nucleophiles than enol ethers: nitrogen is the better donor.","lk":[{"h":"Source","l":[["Mayr database entry 49","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/49"],["J. Am. Chem. Soc. 2001, 123, 9500-9512","https://doi.org/10.1021/ja010890y"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"14.91"},{"x":"5.47","w":"tert-Butyl isocyanide"},{"x":"3.61","w":"2-Methylfuran"},{"x":"0.84","w":"2-Methylpent-1-ene"}],"t":"1-Pyrrolidinocyclohexene","fig":{"m":2477},"ex":"N = 14.91, sN = 0.86 in CH₂Cl₂. About 3.5 N units above the morpholine enamine: the ring O of morpholine withdraws electrons.","lk":[{"h":"Source","l":[["Mayr database entry 71","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/71"],["Chem. Eur. J. 2003, 9, 2209-2218","https://doi.org/10.1002/chem.200204666"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"10.48"},{"x":"−2.77","w":"1-Hexene"},{"x":"0.78","w":"Styrene"},{"x":"8.57","w":"Danishefsky's diene"}],"t":"Diazomethane","f":"CH₂N₂","fig":{"m":2478},"ex":"N = 10.48, sN = 0.78 in CH₂Cl₂. Attacks with carbon; the diazonium ion formed then loses N₂.","lk":[{"h":"Source","l":[["Mayr database entry 185","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/185"],["Chem. Eur. J. 2003, 9, 4068-4076","https://doi.org/10.1002/chem.200304913"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"4.91"},{"x":"0.78","w":"Styrene"},{"x":"9","w":"1-Methoxy-2-methyl-1-(trimethylsiloxy)propene"},{"x":"−2.77","w":"1-Hexene"}],"t":"Ethyl diazoacetate","f":"N₂CHCO₂C₂H₅","fig":{"m":2479},"ex":"N = 4.91, sN = 0.95 in CH₂Cl₂. The ester draws electron density from the diazo carbon: 5.6 N units below diazomethane.","lk":[{"h":"Source","l":[["Mayr database entry 189","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/189"],["Chem. Eur. J. 2003, 9, 4068-4076","https://doi.org/10.1002/chem.200304913"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.47"},{"x":"3.61","w":"2-Methylfuran"},{"x":"1.68","w":"Allyltrimethylsilane"},{"x":"−4.36","w":"Toluene"}],"t":"tert-Butyl isocyanide","f":"(CH₃)₃CNC","fig":{"m":2480},"ex":"N = 5.47, sN = 0.77 in CH₂Cl₂. Isocyanides attack with carbon; the nitrilium ion formed is the intermediate of the Ugi and Passerini reactions.","lk":[{"h":"Source","l":[["Mayr database entry 474","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/474"],["Angew. Chem. Int. Ed. 2007, 46, 3563-3566","https://doi.org/10.1002/anie.200605205"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in CH₂Cl₂?","o":[{"m":2475,"x":"1,1-Diethoxyethene","v":"N 9.81"},{"m":2464,"x":"2-Methylfuran","v":"N 3.61"},{"m":2460,"x":"Isoprene","v":"N 1.1"},{"m":2454,"x":"Toluene","v":"N −4.36"}],"ex":"N in CH₂Cl₂: 1,1-Diethoxyethene 9.81 > 2-Methylfuran 3.61 > Isoprene 1.1 > Toluene −4.36. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["1,1-Diethoxyethene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/336"],["2-Methylfuran","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/42"],["Isoprene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/144"],["Toluene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/27"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in CH₂Cl₂?","o":[{"m":2477,"x":"1-Pyrrolidinocyclohexene","v":"N 14.91"},{"m":2469,"x":"Allyltributylstannane","v":"N 5.46"},{"m":2463,"x":"Furan","v":"N 1.33"},{"m":2455,"x":"1-Hexene","v":"N −2.77"}],"ex":"N in CH₂Cl₂: 1-Pyrrolidinocyclohexene 14.91 > Allyltributylstannane 5.46 > Furan 1.33 > 1-Hexene −2.77. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["1-Pyrrolidinocyclohexene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/71"],["Allyltributylstannane","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/36"],["Furan","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/164"],["1-Hexene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/139"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in CH₂Cl₂?","o":[{"m":2474,"x":"1-Methoxy-2-methyl-1-(trimethylsiloxy)propene","v":"N 9"},{"m":2467,"x":"Indole","v":"N 5.55"},{"m":2458,"x":"2-Methylpent-1-ene"