/details/27"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in CH₂Cl₂?","o":[{"m":2477,"x":"1-Pyrrolidinocyclohexene","v":"N 14.91"},{"m":2475,"x":"1,1-Diethoxyethene","v":"N 9.81"},{"m":2467,"x":"Indole","v":"N 5.55"},{"m":2460,"x":"Isoprene","v":"N 1.1"}],"ex":"N in CH₂Cl₂: 1-Pyrrolidinocyclohexene 14.91 > 1,1-Diethoxyethene 9.81 > Indole 5.55 > Isoprene 1.1. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["1-Pyrrolidinocyclohexene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/71"],["1,1-Diethoxyethene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/336"],["Indole","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/78"],["Isoprene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/144"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in CH₂Cl₂?","o":[{"m":2473,"x":"Danishefsky's diene","v":"N 8.57"},{"m":2469,"x":"Allyltributylstannane","v":"N 5.46"},{"m":2458,"x":"2-Methylpent-1-ene","v":"N 0.84"},{"m":2454,"x":"Toluene","v":"N −4.36"}],"ex":"N in CH₂Cl₂: Danishefsky's diene 8.57 > Allyltributylstannane 5.46 > 2-Methylpent-1-ene 0.84 > Toluene −4.36. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["Danishefsky's diene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/38"],["Allyltributylstannane","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/36"],["2-Methylpent-1-ene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/806"],["Toluene","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/27"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"11.39"},{"x":"16.28","w":"DBN"},{"x":"20.54","w":"Quinuclidine"},{"x":"14.29","w":"Benzylamine"}],"t":"Ammonia","f":"NH₃","fig":{"m":2481},"ex":"N = 11.39, sN = 0.69 in MeCN. Its N is 9.48 in water.","lk":[{"h":"Source","l":[["Mayr database entry 974","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/974"],["J. Org. Chem. 2012, 77, 8142-8155","https://doi.org/10.1021/jo301497g"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"15.19"},{"x":"12.8","w":"Hydroxylamine"},{"x":"17.35","w":"Piperidine"},{"x":"19.95","w":"L-Prolinate"}],"t":"Methylamine","f":"CH₃NH₂","fig":{"m":2482},"ex":"N = 15.19, sN = 0.68 in MeCN. Its N is 13.85 in water.","lk":[{"h":"Source","l":[["Mayr database entry 975","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/975"],["J. Org. Chem. 2012, 77, 8142-8155","https://doi.org/10.1021/jo301497g"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"17.96"},{"x":"12.64","w":"Aniline"},{"x":"19.95","w":"L-Prolinate"},{"x":"15.51","w":"DMAP"}],"t":"Dimethylamine","f":"(CH₃)₂NH","fig":{"m":2483},"ex":"N = 17.96, sN = 0.63 in MeCN. Its N is 17.12 in water.","lk":[{"h":"Source","l":[["Mayr database entry 976","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/976"],["J. Org. Chem. 2012, 77, 8142-8155","https://doi.org/10.1021/jo301497g"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"23.05"},{"x":"10.98","w":"2-Methylpyridine"},{"x":"20.59","w":"N-Methylpyrrolidine"},{"x":"18.58","w":"Pyrrolidine"}],"t":"Trimethylamine","f":"(CH₃)₃N","fig":{"m":2484},"ex":"N = 23.05, sN = 0.45 in MeCN. Each methyl raises N in MeCN: NH₃ < MeNH₂ < Me₂NH < Me₃N. Bulky groups do the opposite (see tert-butylamine).","lk":[{"h":"Source","l":[["Mayr database entry 977","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/977"],["J. Org. Chem. 2012, 77, 8142-8155","https://doi.org/10.1021/jo301497g"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"15.11"},{"x":"17.96","w":"Dimethylamine"},{"x":"19.95","w":"L-Prolinate"},{"x":"12.8","w":"Hydroxylamine"}],"t":"n-Propylamine","f":"CH₃CH₂CH₂NH₂","fig":{"m":2485},"ex":"N = 15.11, sN = 0.63 in MeCN. Its N is 15.7 in DMSO.","lk":[{"h":"Source","l":[["Mayr database entry 639","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/639"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"13.77"},{"x":"11.39","w":"Ammonia"},{"x":"9.11","w":"2,6-Lutidine"},{"x":"18.58","w":"Pyrrolidine"}],"t":"Isopropylamine","f":"(CH₃)₂CHNH₂","fig":{"m":2486},"ex":"N = 13.77, sN = 0.70 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 635","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/635"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"12.35"},{"x":"20.54","w":"Quinuclidine"},{"x":"16.28","w":"DBN"},{"x":"14.29","w":"Benzylamine"}],"t":"tert-Butylamine","f":"(CH₃)₃CNH₂","fig":{"m":2487},"ex":"N = 12.35, sN = 0.72 in MeCN. About as basic as n-propylamine but nearly 3 N units less nucleophilic: steric hindrance. Its N is 10.48 in water.","lk":[{"h":"Source","l":[["Mayr database entry 634","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/634"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"10.13"},{"x":"12.35","w":"tert-Butylamine"},{"x":"20.59","w":"N-Methylpyrrolidine"},{"x":"15.19","w":"Methylamine"}],"t":"2,2,2-Trifluoroethylamine","f":"CF₃CH₂NH₂","fig":{"m":2488},"ex":"N = 10.13, sN = 0.75 in MeCN. The CF₃ group pulls electron density away from nitrogen. Its N is 12.15 in DMSO.","lk":[{"h":"Source","l":[["Mayr database entry 633","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/633"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"14.29"},{"x":"20.54","w":"Quinuclidine"},{"x":"12.64","w":"Aniline"},{"x":"17.96","w":"Dimethylamine"}],"t":"Benzylamine","f":"C₆H₅CH₂NH₂","fig":{"m":2489},"ex":"N = 14.29, sN = 0.67 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 637","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/637"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"14.11"},{"x":"17.35","w":"Piperidine"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"},{"x":"20.54","w":"Quinuclidine"}],"t":"Ethanolamine","f":"HOCH₂CH₂NH₂","fig":{"m":2490},"ex":"N = 14.11, sN = 0.71 in MeCN. Reacts at N, not O: amines are much better nucleophiles than alcohols. Its N is 16.07 in DMSO and 12.61 in water.","lk":[{"h":"Source","l":[["Mayr database entry 636","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/636"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"15.1"},{"x":"23.05","w":"Trimethylamine"},{"x":"12.8","w":"Hydroxylamine"},{"x":"9.11","w":"2,6-Lutidine"}],"t":"Diethylamine","f":"(C₂H₅)₂NH","fig":{"m":2491},"ex":"N = 15.1, sN = 0.73 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 642","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/642"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"18.58"},{"x":"15.1","w":"Diethylamine"},{"x":"11.9","w":"1-Methylimidazole"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"}],"t":"Pyrrolidine","f":"C₄H₈NH","fig":{"m":2492},"ex":"N = 18.58, sN = 0.61 in MeCN. Its alkyl groups are tied back in a ring, so it is more nucleophilic than diethylamine.","lk":[{"h":"Source","l":[["Mayr database entry 1517","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/1517"],["J. Am. Chem. Soc. 2020, 142, 1526-1547","https://doi.org/10.1021/jacs.9b11877"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"17.35"},{"x":"13.77","w":"Isopropylamine"},{"x":"15.29","w":"DBU"},{"x":"23.05","w":"Trimethylamine"}],"t":"Piperidine","f":"C₅H₁₀NH","fig":{"m":2493},"ex":"N = 17.35, sN = 0.68 in MeCN. Its N is 17.19 in DMSO and 18.13 in water.","lk":[{"h":"Source","l":[["Mayr database entry 644","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/644"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"15.65"},{"x":"20.59","w":"N-Methylpyrrolidine"},{"x":"13.77","w":"Isopropylamine"},{"x":"17.35","w":"Piperidine"}],"t":"Morpholine","f":"O(CH₂CH₂)₂NH","fig":{"m":2494},"ex":"N = 15.65, sN = 0.74 in MeCN. The ring oxygen withdraws electrons: 1.7 N units below piperidine. Its N is 16.96 in DMSO and 15.62 in water.","lk":[{"h":"Source","l":[["Mayr database entry 643","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/643"],["Eur. J. Org. Chem. 2009, , 6379-6385","https://doi.org/10.1002/ejoc.200900925"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"20.59"},{"x":"16.28","w":"DBN"},{"x":"23.05","w":"Trimethylamine"},{"x":"12.35","w":"tert-Butylamine"}],"t":"N-Methylpyrrolidine","fig":{"m":2495},"ex":"N = 20.59, sN = 0.52 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 677","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/677"],["J. Phys. Org. Chem. 2010, 23, 1029-1035","https://doi.org/10.1002/poc.1707"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"20.54"},{"x":"13.6","w":"Pyridine"},{"x":"16.45","w":"Hydrazine"},{"x":"11.9","w":"1-Methylimidazole"}],"t":"Quinuclidine","fig":{"m":2496},"ex":"N = 20.54, sN = 0.60 in MeCN. A tertiary amine whose alkyl groups are tied back, leaving the lone pair exposed.","lk":[{"h":"Source","l":[["Mayr database entry 519","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/519"],["Angew. Chem. Int. Ed. 2007, 46, 6176-6179","https://doi.org/10.1002/anie.200701489"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"18.8"},{"x":"12.8","w":"Hydroxylamine"},{"x":"15.11","w":"n-Propylamine"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"}],"t":"DABCO","fig":{"m":2497},"ex":"N = 18.8, sN = 0.70 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 518","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/518"],["Angew. Chem. Int. Ed. 2007, 46, 6176-6179","https://doi.org/10.1002/anie.200701489"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"15.29"},{"x":"17.96","w":"Dimethylamine"},{"x":"13.77","w":"Isopropylamine"},{"x":"23.05","w":"Trimethylamine"}],"t":"DBU","fig":{"m":2498},"ex":"N = 15.29, sN = 0.70 in MeCN. A strong base (pKaH about 24 in MeCN) but only a moderate nucleophile: basicity and nucleophilicity are not the same thing.","lk":[{"h":"Source","l":[["Mayr database entry 559","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/559"],["Chem. Commun. 2008, , 1792-1794","https://doi.org/10.1039/b801811a"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"16.28"},{"x":"11.9","w":"1-Methylimidazole"},{"x":"13.77","w":"Isopropylamine"},{"x":"18.58","w":"Pyrrolidine"}],"t":"DBN","fig":{"m":2499},"ex":"N = 16.28, sN = 0.67 in MeCN. Its N is 15.5 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 560","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/560"],["Chem. Commun. 2008, , 1792-1794","https://doi.org/10.1039/b801811a"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"15.51"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"},{"x":"20.59","w":"N-Methylpyrrolidine"},{"x":"18.58","w":"Pyrrolidine"}],"t":"DMAP","f":"4-(CH₃)₂NC₅H₄N","fig":{"m":2500},"ex":"N = 15.51, sN = 0.62 in MeCN. The ring nitrogen reacts; the NMe₂ group pushes electron density onto it. Its N is 15.8 in CH₂Cl₂ and 13.19 in water.","lk":[{"h":"Source","l":[["Mayr database entry 451","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/451"],["J. Phys. Chem. A 2012, 116, 8494-8499","https://doi.org/10.1021/jp3049247"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"13.6"},{"x":"17.35","w":"Piperidine"},{"x":"11.47","w":"Imidazole"},{"x":"15.19","w":"Methylamine"}],"t":"Pyridine","f":"C₅H₅N","fig":{"m":2501},"ex":"N = 13.6, sN = 0.60 in MeCN. Its N is 11.05 in water.","lk":[{"h":"Source","l":[["Mayr database entry 1673","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/1673"],["Synthesis 2017, 49, 3495-3504","https://doi.org/10.1055/s-0036-1590504"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"10.98"},{"x":"13.42","w":"4-Methoxyaniline"},{"x":"18.8","w":"DABCO"},{"x":"15.1","w":"Diethylamine"}],"t":"2-Methylpyridine","fig":{"m":2502},"ex":"N = 10.98, sN = 0.66 in MeCN. One methyl next to N costs 2.6 N units, although it makes the nitrogen more basic.","lk":[{"h":"Source","l":[["Mayr database entry 1675","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/1675"],["Synthesis 2017, 49, 3495-3504","https://doi.org/10.1055/s-0036-1590504"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"9.11"},{"x":"15.65","w":"Morpholine"},{"x":"17.96","w":"Dimethylamine"},{"x":"19.95","w":"L-Prolinate"}],"t":"2,6-Lutidine","fig":{"m":2503},"ex":"N = 9.11, sN = 0.69 in MeCN. Two methyls flank the nitrogen: a base for when no nucleophile is wanted.","lk":[{"h":"Source","l":[["Mayr database entry 1677","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/1677"],["Synthesis 2017, 49, 3495-3504","https://doi.org/10.1055/s-0036-1590504"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"12.64"},{"x":"19.95","w":"L-Prolinate"},{"x":"15.29","w":"DBU"},{"x":"23.05","w":"Trimethylamine"}],"t":"Aniline","f":"C₆H₅NH₂","fig":{"m":2504},"ex":"N = 12.64, sN = 0.68 in MeCN. The lone pair is shared with the ring. Its N is 12.99 in water.","lk":[{"h":"Source","l":[["Mayr database entry 499","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/499"],["J. Org. Chem. 2007, 72, 3679-3688","https://doi.org/10.1021/jo062586z"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"13.42"},{"x":"18.58","w":"Pyrrolidine"},{"x":"20.59","w":"N-Methylpyrrolidine"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"}],"t":"4-Methoxyaniline","fig":{"m":2505},"ex":"N = 13.42, sN = 0.73 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 503","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/503"],["J. Org. Chem. 2007, 72, 3679-3688","https://doi.org/10.1021/jo062586z"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"11.47"},{"x":"17.96","w":"Dimethylamine"},{"x":"23.05","w":"Trimethylamine"},{"x":"15.65","w":"Morpholine"}],"t":"Imidazole","f":"C₃H₄N₂","fig":{"m":2506},"ex":"N = 11.47, sN = 0.79 in MeCN. Reacts at N3, the pyridine-like nitrogen: the lone pair of the N–H nitrogen is part of the aromatic sextet. Its N is 11.58 in DMSO and 9.63 in water.","lk":[{"h":"Source","l":[["Mayr database entry 655","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/655"],["Org. Biomol. Chem. 2010, 8, 1929-1935","https://doi.org/10.1039/c000965b"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"11.9"},{"x":"14.29","w":"Benzylamine"},{"x":"9.11","w":"2,6-Lutidine"},{"x":"20.59","w":"N-Methylpyrrolidine"}],"t":"1-Methylimidazole","fig":{"m":2507},"ex":"N = 11.9, sN = 0.73 in MeCN.","lk":[{"h":"Source","l":[["Mayr database entry 658","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/658"],["Org. Biomol. Chem. 2010, 8, 1929-1935","https://doi.org/10.1039/c000965b"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"16.45"},{"x":"12.35","w":"tert-Butylamine"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"},{"x":"14.29","w":"Benzylamine"}],"t":"Hydrazine","f":"H₂NNH₂","fig":{"m":2508},"ex":"N = 16.45, sN = 0.56 in MeCN. Close to methylamine: Mayr's group found only a small α-effect for hydrazines. Its N is 13.46 in water.","lk":[{"h":"Source","l":[["Mayr database entry 841","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/841"],["Angew. Chem. Int. Ed. 2012, 51, 1353-1356","https://doi.org/10.1002/anie.201107315"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"12.8"},{"x":"10.13","w":"2,2,2-Trifluoroethylamine"},{"x":"20.54","w":"Quinuclidine"},{"x":"15.19","w":"Methylamine"}],"t":"Hydroxylamine","f":"NH₂OH","fig":{"m":2509},"ex":"N = 12.8, sN = 0.63 in MeCN. Reacts at N, which is why it gives oximes with carbonyl compounds. Its N is 11.41 in water.","lk":[{"h":"Source","l":[["Mayr database entry 972","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/972"],["J. Org. Chem. 2012, 77, 8142-8155","https://doi.org/10.1021/jo301497g"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in MeCN?","o":[{"x":"19.95"},{"x":"12.8","w":"Hydroxylamine"},{"x":"15.65","w":"Morpholine"},{"x":"9.11","w":"2,6-Lutidine"}],"t":"L-Prolinate","fig":{"m":2510},"ex":"N = 19.95, sN = 0.68 in MeCN. Its N is 18.08 in water.","lk":[{"h":"Source","l":[["Mayr database entry 1515","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/1515"],["J. Am. Chem. Soc. 2020, 142, 1526-1547","https://doi.org/10.1021/jacs.9b11877"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in MeCN?","o":[{"m":2495,"x":"N-Methylpyrrolidine","v":"N 20.59"},{"m":2483,"x":"Dimethylamine","v":"N 17.96"},{"m":2491,"x":"Diethylamine","v":"N 15.1"},{"m":2481,"x":"Ammonia","v":"N 11.39"}],"ex":"N in MeCN: N-Methylpyrrolidine 20.59 > Dimethylamine 17.96 > Diethylamine 15.1 > Ammonia 11.39. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["N-Methylpyrrolidine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/677"],["Dimethylamine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/976"],["Diethylamine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/642"],["Ammonia","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/974"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in MeCN?","o":[{"m":2495,"x":"N-Methylpyrrolidine","v":"N 20.59"},{"m":2483,"x":"Dimethylamine","v":"N 17.96"},{"m":2498,"x":"DBU","v":"N 15.29"},{"m":2481,"x":"Ammonia","v":"N 11.39"}],"ex":"N in MeCN: N-Methylpyrrolidine 20.59 > Dimethylamine 17.96 > DBU 15.29 > Ammonia 11.39. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["N-Methylpyrrolidine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/677"],["Dimethylamine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/976"],["DBU","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/559"],["Ammonia","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/974"]]}],"x":true},{"s":"rl","k":"Most nucleophilic","a":"Which of these is the most nucleophilic in MeCN?","o":[{"m":2497,"x":"DABCO","v":"N 18.8"},{"m":2499,"x":"DBN","v":"N 16.28"},{"m":2509,"x":"Hydroxylamine","v":"N 12.8"},{"m":2488,"x":"2,2,2-Trifluoroethylamine","v":"N 10.13"}],"ex":"N in MeCN: DABCO 18.8 > DBN 16.28 > Hydroxylamine 12.8 > 2,2,2-Trifluoroethylamine 10.13. The highest N is the most nucleophilic.","lk":[{"h":"Mayr database","l":[["DABCO","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/518"],["DBN","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/560"],["Hydroxylamine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/972"],["2,2,2-Trifluoroethylamine","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/633"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"14.33"},{"x":"12.32","w":"Dimethyl sulfide"},{"x":"16.17","w":"Tris(4-methoxyphenyl)phosphine"},{"x":"18.39","w":"Tris(4-(dimethylamino)phenyl)phosphine"}],"t":"Triphenylphosphine","f":"P(C₆H₅)₃","fig":{"m":2511},"ex":"N = 14.33, sN = 0.65 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 195","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/195"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"12.58"},{"x":"14.64","w":"Tricyclohexylphosphine"},{"x":"5.51","w":"Triphenyl phosphite"},{"x":"16.17","w":"Tris(4-methoxyphenyl)phosphine"}],"t":"Tris(4-chlorophenyl)phosphine","f":"P(C₆H₄Cl)₃","fig":{"m":2512},"ex":"N = 12.58, sN = 0.65 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 196","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/196"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"15.44"},{"x":"12.32","w":"Dimethyl sulfide"},{"x":"10.36","w":"Tributyl phosphite"},{"x":"18.39","w":"Tris(4-(dimethylamino)phenyl)phosphine"}],"t":"Tri-p-tolylphosphine","f":"P(C₆H₄CH₃)₃","fig":{"m":2513},"ex":"N = 15.44, sN = 0.64 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 197","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/197"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"16.17"},{"x":"18.39","w":"Tris(4-(dimethylamino)phenyl)phosphine"},{"x":"9.54","w":"Phenacylidenetriphenylphosphorane"},{"x":"12.32","w":"Dimethyl sulfide"}],"t":"Tris(4-methoxyphenyl)phosphine","f":"P(C₆H₄OCH₃)₃","fig":{"m":2514},"ex":"N = 16.17, sN = 0.62 in CH₂Cl₂. Para substituents tune phosphorus: Cl 12.58 < H 14.33 < Me 15.44 < OMe 16.17 < NMe₂ 18.39.","lk":[{"h":"Source","l":[["Mayr database entry 198","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/198"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"18.39"},{"x":"12.32","w":"Dimethyl sulfide"},{"x":"15.44","w":"Tri-p-tolylphosphine"},{"x":"5.51","w":"Triphenyl phosphite"}],"t":"Tris(4-(dimethylamino)phenyl)phosphine","f":"P(C₆H₄N(CH₃)₂)₃","fig":{"m":2515},"ex":"N = 18.39, sN = 0.64 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 199","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/199"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"14.64"},{"x":"12.79","w":"Ethyl (triphenylphosphoranylidene)acetate"},{"x":"5.51","w":"Triphenyl phosphite"},{"x":"10.36","w":"Tributyl phosphite"}],"t":"Tricyclohexylphosphine","f":"PCy₃","fig":{"m":2516},"ex":"N = 14.64, sN = 0.68 in CH₂Cl₂. Much more basic than PPh₃ but bulky, so only a little more nucleophilic.","lk":[{"h":"Source","l":[["Mayr database entry 201","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/201"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"15.49"},{"x":"11.95","w":"4-Bromophenacyl dimethylsulfonium ylide"},{"x":"18.39","w":"Tris(4-(dimethylamino)phenyl)phosphine"},{"x":"5.51","w":"Triphenyl phosphite"}],"t":"Tributylphosphine","f":"P(C₄H₉)₃","fig":{"m":2517},"ex":"N = 15.49, sN = 0.69 in CH₂Cl₂.","lk":[{"h":"Source","l":[["Mayr database entry 202","https://www.cup.lmu.de/oc/mayr/reaktionsdatenbank/fe/details/202"],["Chem. Eur. J. 2005, 11, 917-927","https://doi.org/10.1002/chem.200400696"]]}],"x":true},{"s":"rl","k":"N value","a":"What is its N in CH₂Cl₂?","o":[{"x":"5.51"},{"x":"14.64","w":"Tricyclohexylphosphine"},{"x":"18.39","w":"Tris(4-(dimethylamino)phenyl)phosphine"},{"x":"16.17","w":"Tris(4-methoxyphenyl)phosphine"}],"t":"Triphenyl phosphite","f":"P(OC₆H₅)₃","fig":{"m":2518},"ex":"N = 5.51, sN = 0.76 in CH₂Cl₂. O