52},"ex":"Eₚ/₂ = −1.42 V vs SCE in MeCN.","lk":[{"h":"Source","l":[["Roth, Romero & Nicewicz, Synlett 2016","https://doi.org/10.1055/s-0035-1561297"]]}]},{"s":"pr","k":"Potential","a":"What is its Eₚ/₂ vs SCE in MeCN?","o":[{"x":"−2.11 V"},{"x":"−0.98 V","w":"Maleic anhydride"},{"x":"−1.64 V","w":"1,4-Dicyanobenzene"},{"x":"−0.18 V","w":"Bromotrichloromethane"}],"t":"Acetophenone","f":"reduction","fig":{"m":2759},"ex":"Eₚ/₂ = −2.11 V vs SCE in MeCN.","lk":[{"h":"Source","l":[["Roth, Romero & Nicewicz, Synlett 2016","https://doi.org/10.1055/s-0035-1561297"]]}]},{"s":"pr","k":"Potential","a":"What is its Eₚ/₂ vs SCE in MeCN?","o":[{"x":"−2.33 V"},{"x":"−0.93 V","w":"4'-Nitroacetophenone"},{"x":"−0.18 V","w":"Triflyl chloride (CF₃SO₂Cl)"},{"x":"−1.67 V","w":"Ethyl iodide"}],"t":"Cyclohexanone","f":"reduction","fig":{"m":2756},"ex":"Eₚ/₂ = −2.33 V vs SCE in MeCN.","lk":[{"h":"Source","l":[["Roth, Romero & Nicewicz, Synlett 2016","https://doi.org/10.1055/s-0035-1561297"]]}]},{"s":"pr","k":"Potential","a":"What is its Eₚ/₂ vs SCE in MeCN?","o":[{"x":"−2.43 V"},{"x":"−0.45 V","w":"Benzenesulfonyl chloride"},{"x":"−0.93 V","w":"4'-Nitroacetophenone"},{"x":"−1.95 V","w":"1-Bromo-4-iodobenzene"}],"t":"Benzonitrile","f":"reduction","fig":{"m":2853},"ex":"Eₚ/₂ = −2.43 V vs SCE in MeCN.","lk":[{"h":"Source","l":[["Roth, Romero & Nicewicz, Synlett 2016","https://doi.org/10.1055/s-0035-1561297"]]}]},{"s":"pr","k":"Potential","a":"What is its Eₚ/₂ vs SCE in MeCN?","o":[{"x":"−1.64 V"},{"x":"−1.08 V","w":"Ethyl bromoacetate"},{"x":"−2.34 V","w":"Methyl benzoate"},{"x":"−0.18 V","w":"Bromotrichloromethane"}],"t":"1,4-Dicyanobenzene","f":"reduction","fig":{"m":2854},"ex":"Eₚ/₂ = −1.64 V vs SCE in MeCN. MacMillan's α-amino arylation partner; its radical anion couples with α-amino radicals.","lk":[{"h":"Source","l":[["Roth, Romero & Nicewicz, Synlett 2016","https://doi.org/10.1055/s-0035-1561297"]]}]},{"s":"pr","k":"Potential","a":"What is its Eₚ/₂ vs SCE in MeCN?","o":[{"x":"−2.34 V"},