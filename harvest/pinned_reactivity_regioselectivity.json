  "cards": [
    {
      "group_id": "arom",
      "source_index": 0,
      "source_name": "Anisole",
      "conditions": "Br₂, AcOH",
      "ask": "",
      "options": [
        "para",
        "ortho",
        "meta"
      ],
      "source_explanation_en": "OMe donates into the ring, so ortho and para attack give a cation stabilised on oxygen. Para wins: it is less crowded.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 1,
      "source_name": "Nitrobenzene",
      "conditions": "HNO₃, H₂SO₄",
      "ask": "",
      "options": [
        "meta",
        "ortho",
        "para"
      ],
      "source_explanation_en": "Ortho and para attack would put the positive charge next to the electron-poor nitro group; meta attack avoids that.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 2,
      "source_name": "Benzaldehyde",
      "conditions": "HNO₃, H₂SO₄",
      "ask": "",
      "options": [
        "meta",
        "ortho",
        "para"
      ],
      "source_explanation_en": "Like NO₂, the CHO group withdraws electrons and directs meta.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 3,
      "source_name": "Acetanilide",
      "conditions": "Br₂, AcOH",
      "ask": "",
      "options": [
        "para",
        "ortho",
        "meta"
      ],
      "source_explanation_en": "The amide nitrogen donates into the ring; the bulky NHAc group shields the ortho positions.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 4,
      "source_name": "tert-Butylbenzene",
      "conditions": "HNO₃, H₂SO₄",
      "ask": "",
      "options": [
        "para",
        "ortho",
        "meta"
      ],
      "source_explanation_en": "Alkyl groups direct ortho and para; the bulky tert-butyl group blocks ortho.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 5,
      "source_name": "Chlorobenzene",
      "conditions": "HNO₃, H₂SO₄",
      "ask": "",
      "options": [
        "para",
        "ortho",
        "meta"
      ],
      "source_explanation_en": "Halogens slow the reaction down but direct ortho and para: their lone pairs stabilise the cations formed there.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 9,
      "source_name": "Pyrrole",
      "conditions": "POCl₃, DMF (Vilsmeier)",
      "ask": "",
      "options": [
        "C2",
        "C3",
        "N1"
      ],
      "source_explanation_en": "Attack at C2 gives a cation shared over three atoms, including N; attack at C3 shares it over only two.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 10,
      "source_name": "Indole",
      "conditions": "POCl₃, DMF (Vilsmeier)",
      "ask": "",
      "options": [
        "C3",
        "N1",
        "C2"
      ],
      "source_explanation_en": "At C3 the nitrogen stabilises the cation without disrupting the benzene ring.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 11,
      "source_name": "Furan",
      "conditions": "Ac₂O, BF₃·OEt₂",
      "ask": "",
      "options": [
        "C2",
        "C3"
      ],
      "source_explanation_en": "As with pyrrole: the cation from C2 attack is shared over three atoms.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 12,
      "source_name": "Thiophene",
      "conditions": "CH₃COCl, SnCl₄",
      "ask": "",
      "options": [
        "C2",
        "C3"
      ],
      "source_explanation_en": "As with furan and pyrrole, attack at C2 gives a cation shared over three atoms, one of them sulfur.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 14,
      "source_name": "Pyridine N-oxide",
      "conditions": "HNO₃, H₂SO₄",
      "ask": "",
      "options": [
        "C4",
        "C2",
        "C3"
      ],
      "source_explanation_en": "The N-oxide oxygen donates into the ring and directs to C4. PCl₃ removes the oxygen afterwards.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 15,
      "source_name": "Pyridine",
      "conditions": "NaNH₂, then H₂O (Chichibabin)",
      "ask": "Where does the amide ion attack?",
      "options": [
        "C2",
        "C4",
        "C3"
      ],
      "source_explanation_en": "Nucleophiles add at C2 or C4, where the negative charge of the adduct can sit on nitrogen; the amide ion goes to C2.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 16,
      "source_name": "Naphthalene",
      "conditions": "HNO₃, H₂SO₄",
      "ask": "",
      "options": [
        "C1 (α)",
        "C2 (β)"
      ],
      "source_explanation_en": "The cation from C1 attack has more resonance structures that keep the other ring fully aromatic.",
      "hard": false
    },
    {
      "group_id": "arom",
      "source_index": 17,
      "source_name": "Naphthalene",
      "conditions": "H₂SO₄, 160 °C",
      "ask": "",
      "options": [
        "C2 (β)",
        "C1 (α)"
      ],
      "source_explanation_en": "Sulfonation is reversible. At 80 °C the faster 1-sulfonic acid forms (kinetic control); at 160 °C the more stable 2-isomer accumulates, free of the clash with the H at C8 (thermodynamic control).",
      "hard": true
    },
    {
      "group_id": "arom",
      "source_index": 18,
      "source_name": "2-Methoxynaphthalene",
      "conditions": "Br₂, AcOH",
      "ask": "",
      "options": [
        "C1",
        "C3"
      ],
      "source_explanation_en": "C1 is both ortho to OMe and an α-position, so attack there keeps the other ring aromatic.",
      "hard": false
    },
    {
      "group_id": "carbonyl",
      "source_index": 0,
      "source_name": "2-Methylcyclohexanone",
      "conditions": "LDA, THF, −78 °C",
      "ask": "Which α-carbon forms the enolate?",
      "options": [
        "C6 (CH₂)",
        "C2 (CHCH₃)"
      ],
      "source_explanation_en": "LDA at −78 °C removes the more accessible proton fastest and the enolates do not equilibrate: the less substituted (kinetic) enolate.",
      "hard": false
    },
    {
      "group_id": "rings",
      "source_index": 0,
      "source_name": "Propylene oxide",
      "conditions": "NaOMe, MeOH",
      "ask": "Which carbon does methoxide attack?",
      "options": [
        "CH₂ (less substituted)",
        "CH (more substituted)"
      ],
      "source_explanation_en": "Under basic conditions the nucleophile attacks by SN2 at the less hindered carbon.",
      "hard": false
    },
    {
      "group_id": "rings",
      "source_index": 1,
      "source_name": "Propylene oxide",
      "conditions": "MeOH, H₂SO₄ (cat.)",
      "ask": "Which carbon does methanol attack?",
      "options": [
        "CH (more substituted)",
        "CH₂ (less substituted)"
      ],
      "source_explanation_en": "The protonated epoxide opens with a lot of SN1 character: the more substituted carbon carries more of the positive charge.",
      "hard": false
    },
    {
      "group_id": "rings",
      "source_index": 2,
      "source_name": "Styrene oxide",
      "conditions": "MeOH, H₂SO₄ (cat.)",
      "ask": "Which carbon does methanol attack?",
      "options": [
        "benzylic CH",
        "CH₂"
      ],
      "source_explanation_en": "The benzylic carbon carries the positive charge best.",
      "hard": false
    },
    {
      "group_id": "alcohols",
      "source_index": 7,
      "source_name": "(E)-Hex-2-ene-1,6-diol",
      "conditions": "MnO₂, CH₂Cl₂",
      "ask": "Which OH is oxidised?",
      "options": [
        "allylic OH",
        "non-allylic OH"
      ],
      "source_explanation_en": "Activated MnO₂ only oxidises allylic and benzylic alcohols.",
      "hard": false
    }
